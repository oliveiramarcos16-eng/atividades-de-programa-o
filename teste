### 4. Dê um exemplo prático em TypeScript de uma função que lança uma exceção baseada em uma regra de negócio (validação de dados).
**Resposta:**
Abaixo está o exemplo de uma função de transferência bancária que valida se o saldo é suficiente antes de prosseguir.

```typescript
function realizarTransferencia(saldo: number, valor: number): number {
  // Validação da regra de negócio
  if (valor > saldo) {
    // Lançando a exceção manualmente com o 'throw'
    throw new Error("Saldo insuficiente para realizar a transferência.");
  }
  
  if (valor <= 0) {
    throw new Error("O valor da transferência deve ser maior que zero.");
  }

  return saldo - valor;
}

// Executando e tratando a exceção
try {
  const saldoAtual = 100;
  const novoSaldo = realizarTransferencia(saldoAtual, 250); // Vai forçar a exceção
  console.log(`Transferência realizada! Novo saldo: R$${novoSaldo}`);
} catch (error: unknown) {
  if (error instanceof Error) {
    console.error(`[Falha na Operação]: ${error.message}`);
  }
}
```

