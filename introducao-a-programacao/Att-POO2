# [PILAR 4: ABSTRAÇÃO] - Define um contrato abstrato comum para qualquer membro do sistema
class MembroEscola(ABC):
    @abstractmethod
    def exibirInformacoes(self):
        pass

# [PILAR 1: HERANÇA] - Classe base que implementa a estrutura genérica de uma pessoa
class PessoaIntegrada(MembroEscola):
    def __init__(self, nome, cpf):
        self.nome = nome
        # [PILAR 2: ENCAPSULAMENTO] - CPF encapsulado como privado
        self.__cpf = cpf 

    # Métodos de acesso (Getters e Setters) para manipular o dado protegido com segurança
    def get_cpf(self):
        return self.__cpf

    def set_cpf(self, novo_cpf):
        if len(str(novo_cpf)) >= 11:
            self.__cpf = novo_cpf
        else:
            print("Erro: CPF inválido. Deve conter pelo menos 11 dígitos.")

# [PILAR 1: HERANÇA] - Aluno herda propriedades e métodos de PessoaIntegrada
class Aluno(PessoaIntegrada):
    def __init__(self, nome, cpf, matricula):
        super().__init__(nome, cpf)
        self.matricula = matricula

    # [PILAR 3: POLIMORFISMO] - Sobrescrita do método abstrato de forma específica para Aluno
    def exibirInformacoes(self):
        return f"[ALUNO] Nome: {self.nome} | Matrícula: {self.matricula}"

# [PILAR 1: HERANÇA] - Professor herda propriedades e métodos de PessoaIntegrada
class Professor(PessoaIntegrada):
    def __init__(self, nome, cpf, materia):
        super().__init__(nome, cpf)
        self.materia = materia

    # [PILAR 3: POLIMORFISMO] - Sobrescrita do método abstrato de forma específica para Professor
    def exibirInformacoes(self):
        return f"[PROFESSOR] Nome: {self.nome} | Disciplina: {self.materia}"


