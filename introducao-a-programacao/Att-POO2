# ==============================================================================
# ATIVIDADE 2: ENCAPSULAMENTO (Proteção de dados com atributos privados/protegidos)
# ==============================================================================

class ContaBancaria:
    def __init__(self, saldo_inicial=0):
        # Em Python, o prefixo '__' altera o nome do atributo internamente (Name Mangling),
        # impedindo o acesso ou modificação acidental externa (Atributo Privado).
        self.__saldo = saldo_inicial 

    def depositar(self, valor):
        if valor > 0:
            self.__saldo += valor
            print(f"Depósito de R${valor:.2f} realizado com sucesso.")
        else:
            print("Erro: O valor do depósito deve ser maior que zero.")

    def sacar(self, valor):
        if 0 < valor <= self.__saldo:
            self.__saldo -= valor
            print(f"Saque de R${valor:.2f} realizado com sucesso.")
        else:
            print("Erro: Saldo insuficiente ou valor de saque inválido.")

    def consultarSaldo(self):
        return self.__saldo


